# Copy to .env. Variables already set in the shell take precedence.
# Relative paths resolve against the repository root; ${NAME} expands earlier values.

# Storage
JIP_ARTIFACTS=artifacts
JIP_POOL_ARTIFACTS=${JIP_ARTIFACTS}/pools
JIP_LOGS=${JIP_ARTIFACTS}/logs
JIP_DATASETS=datasets
JIP_MODELS=models

# Execution
JIP_PYTHON=python
JIP_VLLM=vllm
JIP_GEN_GPU=0
JIP_JUDGE_GPU=1
JIP_JUDGE_PORT=8100

# Black-box API judge (optional, jip.pipeline.judge_api). Keep the key in .env or in the environment.
# ANTHROPIC_API_KEY=your-api-key
# JIP_ANTHROPIC_ENV_FILE=/path/to/another/.env   # alternative: a dotenv file that defines ANTHROPIC_API_KEY

# Libraries. Set HF_HUB_OFFLINE=1 after models and datasets are cached.
HF_HUB_OFFLINE=0
TOKENIZERS_PARALLELISM=false
VLLM_NO_USAGE_STATS=1
PYTORCH_CUDA_ALLOC_CONF=expandable_segments:True
# HF_HOME=/path/to/huggingface/cache
